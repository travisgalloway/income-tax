{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "debt",
  "type": "object",
  "required": ["_meta", "data"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["source", "title", "provenance", "coverage", "current"],
      "properties": {
        "source": { "type": "string", "minLength": 12 },
        "title": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "required": ["generator", "git_sha", "generated_at"],
          "properties": {
            "generator": { "type": "string", "minLength": 1 },
            "git_sha": { "type": "string", "minLength": 7 },
            "generated_at": { "type": "string", "minLength": 1 }
          }
        },
        "coverage": {
          "type": "object",
          "required": ["start", "end", "gdp_share_available_through"],
          "properties": {
            "start": { "type": "integer" },
            "end": { "type": "integer" },
            "gdp_share_available_through": { "type": "integer" }
          }
        },
        "current": {
          "type": "object",
          "required": ["as_of", "total_t", "held_by_public_t", "intragovernmental_t", "public_share_of_gross_pct"],
          "properties": {
            "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "total_t": { "type": "number", "exclusiveMinimum": 0 },
            "held_by_public_t": { "type": "number", "exclusiveMinimum": 0 },
            "intragovernmental_t": { "type": "number", "exclusiveMinimum": 0 },
            "public_share_of_gross_pct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["y", "debt", "gdp_share", "year_end"],
        "properties": {
          "y": { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "debt": { "type": "number", "exclusiveMinimum": 0 },
          "year_end": { "type": "boolean" },
          "gdp_share": { "type": ["number", "null"], "minimum": 0, "not": { "const": 0 } },
          "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
