{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "states_tax_mix",
  "type": "object",
  "required": ["_meta", "data"],
  "properties": {
    "_meta": { "type": "object", "required": ["source", "provenance", "coverage"] },
    "data": {
      "type": "object",
      "required": ["fy", "categories", "jurisdictions"],
      "properties": {
        "fy": { "type": "integer" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["k", "label", "item"],
            "properties": {
              "k": { "type": "string" },
              "label": { "type": "string" },
              "item": { "type": "string" }
            }
          }
        },
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "name", "total_b", "shares", "not_levied"],
            "properties": {
              "code": { "type": "string", "minLength": 2, "maxLength": 2 },
              "name": { "type": "string" },
              "total_b": { "type": ["number", "null"] },
              "shares": {
                "type": "object",
                "additionalProperties": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "not_levied": { "type": "array", "items": { "type": "string" } },
              "partial": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
