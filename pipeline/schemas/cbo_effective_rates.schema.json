{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cbo_effective_rates",
  "type": "object",
  "required": ["_meta", "data"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["source", "title", "provenance", "refresh"],
      "properties": {
        "source": { "type": "string", "minLength": 12 },
        "title": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "required": ["generator", "git_sha", "generated_at"],
          "properties": {
            "generator": { "type": "string", "minLength": 1 },
            "git_sha": { "type": "string", "minLength": 7 },
            "generated_at": { "type": "string", "minLength": 1 }
          }
        },
        "refresh": {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": { "const": "curated" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["as_of", "basis", "not_an_annual_series", "groups", "rows"],
      "properties": {
        "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "basis": { "type": "string", "minLength": 12 },
        "not_an_annual_series": { "type": "string", "minLength": 12 },
        "groups": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["year", "source_table", "v"],
            "properties": {
              "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
              "source_table": { "type": "string", "minLength": 1 },
              "v": {
                "type": "object",
                "required": ["lowest", "second", "middle", "fourth", "highest", "top1"],
                "properties": {
                  "lowest": { "type": "number", "minimum": 0, "maximum": 100 },
                  "second": { "type": "number", "minimum": 0, "maximum": 100 },
                  "middle": { "type": "number", "minimum": 0, "maximum": 100 },
                  "fourth": { "type": "number", "minimum": 0, "maximum": 100 },
                  "highest": { "type": "number", "minimum": 0, "maximum": 100 },
                  "top1": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        }
      }
    }
  }
}
