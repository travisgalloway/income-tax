---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getEntry, render } from 'astro:content'

const entry = await getEntry('reference', 'sources')
if (!entry) throw new Error('SOURCES.md did not load. /sources renders it in full; refusing to build a stub.')
const { Content, headings } = await render(entry)

/* /sources was the one route that rendered without a rail, because
 * `sections.ts` carries an empty list for it: this page's sections are the
 * headings of `SOURCES.md`, and a markdown document does not declare itself in
 * the manifest. `render()` returns those headings already, with the same slugs
 * it puts on the rendered `<h2>` elements, so the rail and the document cannot
 * disagree. Depth 2 only, matching the other routes, where the rail lists
 * sections and not the headings inside them. */
const sections = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }))
---

<BaseLayout
  title="Sources | US federal finance"
  description="Every source, with vintage and known discrepancies."
  sections={sections}
>
  <p class="kicker">Reference</p>
  <section id="reference" class="reference-doc">
    <Content />
  </section>
</BaseLayout>
