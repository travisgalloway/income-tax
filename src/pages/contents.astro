---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { routeFigures } from '../data/figures'
import { sortKey } from '../data/glossary-sort'
import { join, siteRoutes, type ContentRoute } from '../data/sections'

/* Static Astro, no island, no hydration directive and no chart: this page is a list of links, so
 * #36's server-render rule is satisfied vacuously and greppably. The directive's name is
 * deliberately not written in this file — the criterion that proves the rule greps for it, and a
 * mention in a comment would read as a use. */

/* Nothing on this page is written here. Routes and their labels come from `siteRoutes`; section
 * ids and labels from the same arrays each route renders its own contents list from; figure
 * numbers, titles and sources from the manifest the figures themselves render from; terms from
 * the glossary collection. A section renamed, a figure added or a term defined changes this page
 * in the same build, with no edit to this file — which is the whole of what it is for. */

const entries = await getCollection('glossary')

if (entries.length === 0) {
  throw new Error(
    'The glossary collection loaded no entries. /contents indexes the site\'s vocabulary; refusing to build a heading over nothing.'
  )
}

/* The same ordering /glossary renders in, from the same module, so the index and the page it
 * indexes cannot disagree about where a term sits. */
const terms = entries
  .map((e) => ({ entry: e, key: sortKey(e.data.term) }))
  .sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : a.entry.id < b.entry.id ? -1 : 1))

/* An id per route block. `/` has no path segment to slug, so it is named for what it is. */
const blockId = (path: string) => `contents-${path === '/' ? 'introduction' : path.replace(/^\//, '')}`

/* `siteRoutes` also carries `/`, `/sources` and `/glossary`, none of which are `ContentRoute`
 * keys and so carry no figures. A real type guard, not an `as ContentRoute` assertion, keeps
 * the compiler honest about that instead of lying to it for every route in the array. */
const isContentRoute = (path: string): path is ContentRoute =>
  Object.prototype.hasOwnProperty.call(routeFigures, path)

/* Every destination the rail names except this one. Listing the index inside the index would make
 * its own section list self-referential; the rail still carries it, which is how a reader gets
 * here. */
const blocks = siteRoutes
  .filter((r) => r.path !== '/contents')
  .map((r) => ({
    ...r,
    id: blockId(r.path),
    href: join(r.path),
    figures: isContentRoute(r.path) ? routeFigures[r.path] : [],
  }))

/* Own `sections` prop, built from the same loop the page renders, so the rail's contents list and
 * the page cannot disagree. */
const sections = [
  ...blocks.map((b) => ({ id: b.id, label: b.label })),
  { id: 'contents-terms', label: 'Terms' },
]

/* A first-use link's label is the route label plus the section label, both looked up rather than
 * typed. Both anchors are already gated at build time by /glossary's `first_used` check, so a
 * dangling one fails the build before this page can render it. */
const firstUsedLabel = (route: string, anchor: string) => {
  const r = siteRoutes.find((s) => s.path === route)
  const section = r?.sections.find((s) => s.id === anchor)
  if (!r || !section) {
    throw new Error(
      `/contents: a term declares first_used ${route}#${anchor}, which names no section this site renders. See src/data/sections.ts.`
    )
  }
  return `${r.label}, ${section.label}`
}

const figureCount = blocks.reduce((n, b) => n + b.figures.length, 0)
const sectionCount = blocks.reduce((n, b) => n + b.sections.length, 0)
---

<BaseLayout
  title="Contents | US federal finance"
  description="Every route, section, numbered figure and defined term on this site, with a link to each."
  sections={sections}
>
  <p class="kicker">Reference</p>
  <h1>Contents</h1>
  <p class="standfirst">
    The whole of the site on one page: {sectionCount} sections across {blocks.length} destinations,
    {figureCount} numbered figures with their sources, and {terms.length} defined terms. Nothing
    here is a list somebody keeps up to date — every line is read from the same declaration the
    page it points at renders from.
  </p>

  {blocks.map((block) => (
    <section id={block.id}>
      <h2><a href={block.href}>{block.label}</a></h2>
      {block.sections.length === 0 ? (
        <p class="index-empty">
          One page, with no section anchors of its own.
          {block.path === '/glossary' && ' Its terms are listed below.'}
        </p>
      ) : (
        <ol class="index-sections">
          {block.sections.map((s) => (
            <li class="index-section">
              <a href={`${block.href}#${s.id}`}>{s.label}</a>
              {block.figures
                .filter((f) => f.section === s.id)
                .map((f) => (
                  <p class="index-figure">
                    <span class="index-figure-no">{block.label}, Figure {f.n}.</span>
                    <span class="index-figure-title">{f.title}</span>
                    <span class="index-source"><span class="lead">Source.</span> {f.sourceLine}</span>
                  </p>
                ))}
            </li>
          ))}
        </ol>
      )}
    </section>
  ))}

  <section id="contents-terms">
    <h2><a href={join('/glossary')}>Terms</a></h2>
    <ol class="index-terms">
      {terms.map(({ entry }) => (
        <li class="index-term">
          <a class="index-term-name" href={join(`/glossary#${entry.id}`)}>{entry.data.term}</a>
          <span class="index-term-short">{entry.data.short}</span>
          <span class="index-term-first">
            <span class="lead">First used.</span>{' '}
            <a href={`${join(entry.data.first_used.route)}#${entry.data.first_used.anchor}`}>
              {firstUsedLabel(entry.data.first_used.route, entry.data.first_used.anchor)}
            </a>
          </span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
