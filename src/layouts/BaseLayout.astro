---
import '../styles/global.css'

interface NavItem { id: string; label: string }
interface Props {
  title: string
  description: string
  /** Section anchors for the nav rail. */
  sections?: NavItem[]
}

const { title, description, sections = [] } = Astro.props

const base = import.meta.env.BASE_URL
const join = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`.replace(/\/$/, '') || '/'

const routes = [
  { href: join(''), label: 'Economy' },
  { href: join('households'), label: 'Households' },
  { href: join('government'), label: 'Government' },
  { href: join('sources'), label: 'Sources' },
]

const current = Astro.url.pathname.replace(/\/$/, '')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <div class="shell">
        <nav class="rail" aria-label="Site">
          <ol class="route-links">
            {routes.map((r) => (
              <li>
                <a href={r.href} aria-current={r.href.replace(/\/$/, '') === current ? 'page' : undefined}>
                  {r.label}
                </a>
              </li>
            ))}
          </ol>
          {sections.length > 0 && (
            <>
              <p class="toc-heading">Contents</p>
              <ol class="toc" aria-label="Sections">
                {sections.map((s, i) => (
                  <li>
                    <span class="n" aria-hidden="true">{i + 1}.</span>
                    <a href={`#${s.id}`}>{s.label}</a>
                  </li>
                ))}
              </ol>
            </>
          )}
        </nav>
        <main id="main">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
