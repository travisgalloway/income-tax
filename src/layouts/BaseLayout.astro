  },
  {
    choice: 'system',
    label: 'System',
    /* half-2, a disc filled on one side, for the theme the operating system decides */
    d: 'M7.49991 0.876892C3.84222 0.876892 0.877075 3.84204 0.877075 7.49972C0.877075 11.1574 3.84222 14.1226 7.49991 14.1226C11.1576 14.1226 14.1227 11.1574 14.1227 7.49972C14.1227 3.84204 11.1576 0.876892 7.49991 0.876892ZM7.49988 1.82689C4.36688 1.8269 1.82707 4.36672 1.82707 7.49972C1.82707 10.6327 4.36688 13.1725 7.49988 13.1726V1.82689Z',
  },
]

/* github-logo, from the same set. The repository the site is built from, and the URL resolves. */
const sourceUrl = 'https://github.com/travisgalloway/income-tax'
const sourceIconPath =
  'M7.49933 0.25C3.49635 0.25 0.25 3.49593 0.25 7.50024C0.25 10.703 2.32715 13.4206 5.2081 14.3797C5.57084 14.446 5.70302 14.2222 5.70302 14.0299C5.70302 13.8576 5.69679 13.4019 5.69323 12.797C3.67661 13.235 3.25112 11.825 3.25112 11.825C2.92132 10.9874 2.44599 10.7644 2.44599 10.7644C1.78773 10.3149 2.49584 10.3238 2.49584 10.3238C3.22353 10.375 3.60629 11.0711 3.60629 11.0711C4.25298 12.1788 5.30335 11.8588 5.71638 11.6732C5.78225 11.205 5.96962 10.8854 6.17658 10.7043C4.56675 10.5209 2.87415 9.89918 2.87415 7.12104C2.87415 6.32925 3.15677 5.68257 3.62053 5.17563C3.54576 4.99226 3.29697 4.25521 3.69174 3.25691C3.69174 3.25691 4.30015 3.06196 5.68522 3.99973C6.26337 3.83906 6.8838 3.75895 7.50022 3.75583C8.1162 3.75895 8.73619 3.83906 9.31523 3.99973C10.6994 3.06196 11.3069 3.25691 11.3069 3.25691C11.7026 4.25521 11.4538 4.99226 11.3795 5.17563C11.8441 5.68257 12.1245 6.32925 12.1245 7.12104C12.1245 9.9063 10.4292 10.5192 8.81452 10.6985C9.07444 10.9224 9.30633 11.3648 9.30633 12.0413C9.30633 13.0102 9.29742 13.7922 9.29742 14.0299C9.29742 14.2239 9.42828 14.4496 9.79591 14.3788C12.6746 13.4179 14.75 10.7025 14.75 7.50024C14.75 3.49593 11.5036 0.25 7.49933 0.25Z'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {/* Theme, applied before first paint.
     * Inline and synchronous on purpose: a deferred script would let the page
     * paint light and then repaint dark, which is the flash every themed site
     * gets wrong once. `system` is stored as the absence of the attribute, so
     * the media query in tokens.css handles it with no third branch and this
     * script writes nothing in that case. */}
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('theme')
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored)
          }
        } catch (e) {
          /* Private mode, or storage disabled. System default is the right
           * fallback, and it is what the absent attribute already gives. */
        }
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <noscript>
      <style>
        /* useChartSize returns the WIDE preset (720x396) before the first
         * client measurement, so with scripting off the wide viewBox is never
         * swapped for the narrow one and chart text is scaled down with the
         * plot, an 11px axis label lands around 5.4px at a 390px viewport.
         * Sized in viewBox units to land back near 10-11px rendered. This
         * mitigates legibility; it does not fix the underlying geometry, see
         * docs/contracts/accessibility.md, "Known limitation". */
        @media (max-width: 34.9rem) {
          .axis-label { font-size: 20px; }
          .axis-title { font-size: 19px; }
          .annotation { font-size: 21px; }
        }

        /* #73: with scripting off there is no tap-to-read and no hover
         * readout, the marks never hydrate, so neither gesture the other two
         * hint sentences name does anything. The table is the only route to a
         * number that genuinely works here (TableView is a native <details>),
         * and the hint must say so. Reuses the mechanism already in <head> for
         * the chart-legibility mitigation above: no inline script, no `js`
         * class, no flash, nothing new to hydrate.
         *
         * `!important` because this block precedes the bundled stylesheet and
         * the `@media (hover: …)` rules there would otherwise win on source
         * order. Verified in the browser (B2c) rather than assumed. */
        .hint-hover, .hint-touch { display: none !important; }
        .hint-nojs { display: inline !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/* The site bar. Present at every width, unlike the old narrow-only navbar:
     * the left rail it replaces used to carry the routes at >= 62rem, and with
     * the rail gone this is the only place they live. Below 62rem the route list
     * collapses into the disclosure, which is the same native <details> the old
     * navbar used and works with scripting off.
     *
     * Sits after the skip link so the skip link stays the first focusable node,
     * and is `position: sticky`, so its DOM position costs nothing visually. */}
    <header class="navbar">
      <a class="navbar-title" href={home} aria-current={isCurrent(home) ? 'page' : undefined}>Income &amp; Tax</a>

      {/* The wide route list. `display: none` below 62rem, where the disclosure
       * below carries the same links. Exactly one of the two is ever in the
       * accessibility tree, which is how the page exposes two <nav> landmarks
       * at every width rather than four. */}
      <nav class="navbar-routes-wide" aria-label="Site">
        <ol>
          {routes.map((r) => (
            <li>
              <a href={r.href} aria-current={isCurrent(r.href) ? 'page' : undefined}>
                {r.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {/* Light, dark and system. `system` is the absence of a `data-theme`
       * attribute rather than a third value, so the media query in tokens.css
       * needs no third branch. Rendered with `light` pre-checked and corrected
       * by the head script before paint, so the control agrees with the page
       * even when the stored choice is dark.
       *
       * The three words became three icons, and each button keeps the word as
       * its accessible name in a `.vh` span. The `<svg>` is `aria-hidden` and
       * `focusable="false"`, so a screen reader meets the name alone and no
       * engine puts the glyph in the tab order. */}
      <div class="theme-toggle" role="radiogroup" aria-label="Colour theme">
        {themeOptions.map((o, i) => (
          <button
            type="button"
            class="theme-option"
            data-theme-choice={o.choice}
            role="radio"
            aria-checked={i === 0 ? 'true' : 'false'}
          >
            <svg class="navbar-icon" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" focusable="false">
              <path d={o.d} fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path>
            </svg>
            <span class="vh">{o.label}</span>
          </button>
        ))}
      </div>

      {/* The source, beside the setting it sits with, because both are about
       * the site rather than about the page. The name says where the link goes,
       * which an icon cannot say on its own. */}
      <a class="navbar-source" href={sourceUrl}>
        <svg class="navbar-icon" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" focusable="false">
          <path d={sourceIconPath} fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
        <span class="vh">Source code on GitHub</span>
      </a>

      <details class="navbar-disclosure" id="navbar-disclosure">
        <summary class="navbar-trigger">
          <span class="navbar-where" data-navbar-where>{currentRoute?.label ?? 'Menu'}</span>
          <span class="vh"> — routes and contents</span>
          <span class="navbar-chevron" aria-hidden="true"></span>
        </summary>
        <div class="navbar-panel" id="navbar-panel" tabindex="-1">
          <nav aria-label="Site">
            <ol class="navbar-routes">
              {routes.map((r) => (
                <li>
                  <a href={r.href} aria-current={isCurrent(r.href) ? 'page' : undefined}>
                    {r.label}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
          {sections.length > 0 && (
            <nav aria-labelledby="navbar-toc-heading">
              <p class="navbar-toc-heading" id="navbar-toc-heading">On this page</p>
              <ol class="toc navbar-toc">
                {sections.map((s, i) => (
                  <li>
                    <span class="n" aria-hidden="true">{i + 1}.</span>
                    <a href={`#${s.id}`} data-section={s.id}>{s.label}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>
      </details>
    </header>
    <div class="page">
      <div class="shell">
        {/* `<main>` precedes the rail in the DOM now, where the old left rail
         * preceded it. Reading order therefore reaches the content first, and
         * the contents list reads as the aside it is. */}
        <main id="main" tabindex="-1">
          <slot />
        </main>
        {sections.length > 0 && (
          <aside class="rail">
            <nav aria-labelledby="toc-heading">
              <p class="toc-heading" id="toc-heading">On this page</p>
              <ol class="toc">
                {sections.map((s, i) => (
                  <li>
                    <span class="n" aria-hidden="true">{i + 1}.</span>
                    <a href={`#${s.id}`} data-section={s.id}>{s.label}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
      </div>
    </div>
    <script is:inline>
      /* Progressive enhancement over the native <details> disclosure above: the
       * panel opens, closes and exposes every link with zero scripting, and
       * only Escape-to-close, focus-return and the two dismissals below need
       * this. `is:inline` because the bar is layout chrome, not an island, it
       * must work on first paint, with no bundle and no hydration. */
      ;(function navbarEnhancement() {
        var d = document.getElementById('navbar-disclosure')
        if (!d) return
        var trigger = d.querySelector('summary')
        var panel = document.getElementById('navbar-panel')
        function close(refocus) {
          if (!d.open) return
          d.open = false
          if (refocus) trigger.focus()
        }
        d.addEventListener('toggle', function () {
          if (d.open) panel.focus()
        })
        /* On `d`, not on `document`: focus is inside `d` whenever the panel is
         * open, and a document-level handler would contend with the three
         * /government/ filter dropdowns that already own Escape. */
        d.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            e.preventDefault()
            close(true)
          }
        })
        /* A same-page anchor does not reload, so without this the panel stays
         * open covering the section it just scrolled to. */
        panel.addEventListener('click', function (e) {
          if (e.target instanceof Element && e.target.closest('a')) close(false)
        })
        document.addEventListener('click', function (e) {
          if (!d.contains(e.target)) close(false)
        })
      })()

      /* Marks the section containing the viewport midpoint with
       * `aria-current='true'`, single-quoted throughout this comment on
       * purpose, because the built page must carry zero double-quoted literal
       * of that attribute and a comment is served verbatim. Both contents
       * lists at once: the rail's anchors and the panel's carry the same
       * `data-section` value, so one `querySelectorAll` writes both and they
       * cannot drift.
       *
       * Nothing is marked with scripting off, and that is correct: marking
       * section 1 server-side would be wrong for every reader who is not at the
       * top. Neither list is a live region, so changing this attribute on an
       * unfocused link announces nothing while scrolling, see
       * docs/contracts/accessibility.md. No scripted scrolling exists here at
       * all, which is how prefers-reduced-motion is satisfied: vacuously, and
       * greppably, the same way the bar above satisfies it. */
      /* The theme control.
       *
       * Three states, and `system` is the absence of `data-theme` rather than a
       * third attribute value. That asymmetry is deliberate: it is what lets the
       * `prefers-color-scheme` media query in tokens.css stay a two-branch rule
       * and still be correct for all three.
       *
       * Nothing here reads or writes a colour. The attribute selects a token
       * block and the stylesheet decides what that means, so no hex is held in
       * JavaScript and the two cannot disagree. */
      ;(function themeControl() {
        var root = document.documentElement
        var buttons = document.querySelectorAll('[data-theme-choice]')
        if (!buttons.length) return

        var mq = window.matchMedia('(prefers-color-scheme: dark)')

        function stored() {
          try {
            var v = localStorage.getItem('theme')
            return v === 'light' || v === 'dark' ? v : 'system'
          } catch (e) {
            return 'system'
          }
        }

        function mark(choice) {
          for (var i = 0; i < buttons.length; i++) {
            var b = buttons[i]
            b.setAttribute('aria-checked', b.getAttribute('data-theme-choice') === choice ? 'true' : 'false')
            /* Roving tabindex, the pattern a radiogroup owes a keyboard reader:
             * one stop for the group, and arrow keys move within it. */
            b.tabIndex = b.getAttribute('data-theme-choice') === choice ? 0 : -1
          }
        }

        function apply(choice) {
          if (choice === 'system') root.removeAttribute('data-theme')
          else root.setAttribute('data-theme', choice)
          try {
            if (choice === 'system') localStorage.removeItem('theme')
            else localStorage.setItem('theme', choice)
          } catch (e) {
            /* The attribute is already set; only persistence is lost. */
          }
          mark(choice)
        }

        for (var i = 0; i < buttons.length; i++) {
          buttons[i].addEventListener('click', function () {
            apply(this.getAttribute('data-theme-choice'))
          })
          buttons[i].addEventListener('keydown', function (e) {
            var k = e.key
            if (k !== 'ArrowRight' && k !== 'ArrowLeft' && k !== 'ArrowDown' && k !== 'ArrowUp') return
            e.preventDefault()
            var list = Array.prototype.slice.call(buttons)
            var at = list.indexOf(this)
            var step = k === 'ArrowRight' || k === 'ArrowDown' ? 1 : -1
            var next = list[(at + step + list.length) % list.length]
            apply(next.getAttribute('data-theme-choice'))
            next.focus()
          })
        }

        /* System mode follows the operating system mid-session. Without this the
         * page would hold whatever the system was when it loaded. */
        var onChange = function () {
          if (stored() === 'system') mark('system')
        }
        if (mq.addEventListener) mq.addEventListener('change', onChange)
        else if (mq.addListener) mq.addListener(onChange)

        mark(stored())
      })()

      ;(function sectionSpy() {
        var sections = Array.prototype.slice.call(
          document.querySelectorAll('main section[id]')
        )
        var links = document.querySelectorAll('a[data-section]')
        if (sections.length === 0 || links.length === 0) return  /* / and /sources */

        var visible = {}
        var last = 0
        var applied = -1

        function pick() {
          var doc = document.documentElement
          /* `limits` is short on every route and may never reach the band, so
           * the document bottom is decided by scroll position, not by the
           * observer. */
          if (window.scrollY + window.innerHeight >= doc.scrollHeight - 2) {
            return sections.length - 1
          }
          for (var i = 0; i < sections.length; i++) {
            if (visible[sections[i].id]) return i    /* document order, first wins */
          }
          /* Above section 1's top edge: the kicker/h1/standfirst block owns the
           * midpoint. */
          if (sections[0].getBoundingClientRect().top > window.innerHeight / 2) return 0
          return last                                /* hold; never un-mark */
        }

        function apply() {
          var i = pick()
          last = i
          if (i === applied) return                  /* no DOM write per frame */
          applied = i
          for (var j = 0; j < links.length; j++) links[j].removeAttribute('aria-current')
          var marked = document.querySelectorAll(
            'a[data-section="' + sections[i].id + '"]'
          )
          for (var k = 0; k < marked.length; k++) {
            marked[k].setAttribute('aria-current', 'true')
          }
        }

        var pending = false
        function schedule() {
          if (pending) return
          pending = true
          window.requestAnimationFrame(function () {
            pending = false
            apply()
          })
        }

        /* A band ~0.5% of the viewport tall across the midpoint. Deliberately
         * not `-50% 0px -50% 0px`: that collapses the root rect to zero height,
         * and whether a zero-area intersection reports `isIntersecting` at
         * threshold 0 differs between engines. Sections tile contiguously
         * inside <main>, so the band is inside exactly one of them everywhere
         * between the first section's top and the last section's bottom, band
         * containment is the midpoint rule. Where two straddle the ~4px window
         * at a boundary, `pick()` takes the earlier in document order, in both
         * scroll directions, so the mark cannot oscillate. */
        var io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            visible[entries[i].target.id] = entries[i].isIntersecting
          }
          apply()
        }, { rootMargin: '-50% 0px -49.5% 0px', threshold: 0 })
        for (var s = 0; s < sections.length; s++) io.observe(sections[s])

        window.addEventListener('scroll', schedule, { passive: true })
        window.addEventListener('resize', schedule, { passive: true })
        /* The jump produces a scroll event too, but this makes the post-jump
         * state deterministic rather than dependent on that. */
        window.addEventListener('hashchange', schedule)
        apply()
      })()

      /* In-prose glossary markers (#47). One IIFE shared by every marked term
       * on the page, for the same reason as the two above: layout chrome, not
       * an island, no bundle, no hydration, correct on first paint. An
       * `is:inline` block inside Term.astro would emit this once per marked
       * term, and a component <script> would add a module the page then has to
       * fetch, for ~25 instances of it.
       *
       * With scripting off nothing below runs and the markup is already
       * correct: each trigger is a real <a href> to the term's /glossary
       * anchor, and the definition is in the served bytes as the trigger's
       * aria-describedby target.
       *
       * Two invariants the rest of this reads as given. The popover is a DOM
       * descendant of its wrapper, so a pointer travelling from the trigger
       * onto the popover never leaves the wrapper and never fires
       * `pointerleave`, WCAG 1.4.13 hoverable is the DOM shape, and the
       * 150ms close delay is redundancy. And nothing here closes on a timer:
       * only Escape, a Tab out of the wrapper, a click outside, or another
       * term opening. That is 1.4.13 persistent.
       *
       * Nothing here moves the viewport and nothing here is a live region:
       * the definition reaches assistive technology as the trigger's
       * description, announced on arrival at the trigger rather than on every
       * hover. */
      ;(function termPopovers() {
        var terms = document.querySelectorAll('.term')
        if (terms.length === 0) return          /* /, /sources, /glossary */

        var open = null
        var enterTimer = null
        var leaveTimer = null
        /* Set only across the focus() call in close(), which would otherwise
         * re-enter show() through the trigger's own focus handler and reopen
         * what Escape just dismissed. */
        var refocusing = false

        function popOf(t) { return t.querySelector('.term-pop') }
        function triggerOf(t) { return t.querySelector('.term-trigger') }

        function close(t, refocus) {
          if (!t) return
          popOf(t).hidden = true
          triggerOf(t).setAttribute('aria-expanded', 'false')
          if (open === t) open = null
          if (refocus) {
            refocusing = true
            triggerOf(t).focus()
            refocusing = false
          }
        }

        function show(t) {
          if (open && open !== t) close(open)   /* one at a time, so two marked
                                                 * terms in one sentence cannot
                                                 * overlap */
          var trigger = triggerOf(t)
          var pop = popOf(t)
          /* The only number script supplies. `offsetParent` is whichever
           * ancestor CSS makes a positioning context, `p`, `li`, `h2` or
           * `.standfirst` containing `.term`, per the `:has(.term)` rule in
           * global.css, and offsetHeight spans both line boxes when the
           * trigger wraps, so the popover lands below the whole trigger
           * rather than through it. Recomputed on every open, so a resize
           * between opens needs no listener. */
          pop.style.top = (trigger.offsetTop + trigger.offsetHeight) + 'px'
          pop.hidden = false
          trigger.setAttribute('aria-expanded', 'true')
          open = t
        }

        function wire(t) {
          var trigger = triggerOf(t)
          if (!trigger || !popOf(t)) return
          trigger.setAttribute('aria-expanded', 'false')

          t.addEventListener('pointerenter', function () {
            window.clearTimeout(leaveTimer)
            window.clearTimeout(enterTimer)
            /* Long enough not to flash at a reader skimming past. */
            enterTimer = window.setTimeout(function () { show(t) }, 120)
          })
          t.addEventListener('pointerleave', function () {
            window.clearTimeout(enterTimer)
            window.clearTimeout(leaveTimer)
            /* A keyboard reader who happens to move the mouse keeps their
             * popover: focus, not the pointer, owns it while it is inside. */
            if (t.contains(document.activeElement)) return
            leaveTimer = window.setTimeout(function () { close(t) }, 150)
          })
          /* Uniform across pointer types, deliberately not branched on
           * `pointerType`: hover emulation is where phone support goes wrong,
           * and a branch is a second path nobody tests on a phone. One tap
           * opens and never navigates first; navigation is the popover's own
           * link, one deliberate action away, for everyone. The platform's
           * affordances are left alone, so open-in-new-tab, middle-click and
           * shift-click still reach /glossary. */
          trigger.addEventListener('click', function (e) {
            if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
            e.preventDefault()
            show(t)
          })
          trigger.addEventListener('focus', function () {
            if (!refocusing) show(t)
          })
          /* On `t`, not on `document`: focus is inside the wrapper whenever
           * the popover is open, and a document-level handler would contend
           * with the nav panel and the three /government/ filter dropdowns
           * that already own Escape. Focus stays exactly where it is unless it
           * was inside the popover about to be hidden, so nothing here moves
           * the reader. */
          t.addEventListener('keydown', function (e) {
            /* An <a> synthesizes a click on Enter but not on Space, Space's
             * default on a link is to scroll the page. The a11y contract
             * ("Enter / Space | opens; does not navigate") promises both, so
             * Space is intercepted here the same way Enter already arrives
             * via the trigger's own click event. */
            if (e.key === ' ' && e.target === trigger) {
              e.preventDefault()
              show(t)
              return
            }
            if (e.key !== 'Escape') return
            e.preventDefault()
            var inside = t.contains(document.activeElement) && document.activeElement !== trigger
            close(t, inside)
          })
          /* What makes "Tab past the popover's link closes it" true without a
           * blur race, and Shift-Tab off the trigger the same. */
          t.addEventListener('focusout', function (e) {
            if (!e.relatedTarget || !t.contains(e.relatedTarget)) close(t)
          })
        }

        for (var i = 0; i < terms.length; i++) wire(terms[i])

        document.addEventListener('click', function (e) {
          if (open && !open.contains(e.target)) close(open)
        })
      })()
    </script>
  </body>
</html>
